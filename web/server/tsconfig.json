{
  "compilerOptions": {
    "target": "ES2020" /* Modern JS support */,
    "module": "CommonJS" /* Standard for Node.js backends */,
    "rootDir": "./src" /* Your TS source files location */,
    "outDir": "./dist" /* Where compiled JS goes */,
    "esModuleInterop": true /* Compatibility for importing JS libs */,
    "forceConsistentCasingInFileNames": true,
    "strict": true /* Ensures you learn proper TypeScript */,
    "skipLibCheck": true /* Speeds up compilation */,
    "sourceMap": true /* Helps in debugging */,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"] /* Tells TS to look inside src/ */,
  "exclude": ["node_modules"]
}

